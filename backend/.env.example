# Environment Configuration for Mindful AI Counselor Backend
# Copy this file to .env and fill in your actual values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME="Mindful AI Counselor"
VERSION="1.0.0"
ENVIRONMENT=development  # Options: development, staging, production
DEBUG=false

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string with async driver
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aicounselor
SQL_ECHO=false  # Set to true to log all SQL queries (useful for debugging)

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis connection string for caching and rate limiting
# Format: redis://host:port/db_number
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600  # Cache time-to-live (1 hour)
SIMILARITY_THRESHOLD=0.85  # Embedding similarity threshold for semantic search

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Generate a secure random key (min 32 characters)
# Example: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-minimum-32-characters-required-change-in-production

# CORS allowed origins (comma-separated list)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# OPENAI CONFIGURATION
# =============================================================================
# OpenAI API key for GPT-4 chat completions
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini  # Options: gpt-4, gpt-4o-mini, gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000  # Maximum tokens per response
OPENAI_TEMPERATURE=0.7  # Response randomness (0.0-2.0, lower = more focused)

# =============================================================================
# CONTEXT MANAGEMENT
# =============================================================================
MAX_CONTEXT_MESSAGES=20  # Maximum messages to include in conversation context
VECTOR_SEARCH_TOP_K=5  # Number of similar messages to retrieve from vector search

# =============================================================================
# CRISIS DETECTION SETTINGS
# =============================================================================
CRISIS_KEYWORDS_THRESHOLD=3  # Number of crisis keywords to trigger high alert
CRISIS_ALERT_EMAIL=""  # Optional: Email address for crisis alerts
CRISIS_KEYWORDS="suicide,kill myself,end my life,self-harm,hurt myself,don't want to live,no reason to live,better off dead"

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_PER_MINUTE=60  # Maximum API requests per minute per user
RATE_LIMIT_PER_HOUR=500  # Maximum API requests per hour per user

# =============================================================================
# COMPLIANCE & PRIVACY
# =============================================================================
ENABLE_ENCRYPTION=true  # Enable field-level encryption for sensitive data
DATA_RETENTION_DAYS=90  # Number of days to retain user data
ENABLE_AUDIT_LOG=true  # Enable audit logging for compliance

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
SENTRY_DSN=""  # Optional: Sentry DSN for error tracking
