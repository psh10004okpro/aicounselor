# =============================================
# Mindful AI Counselor - Environment Variables
# =============================================

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
POSTGRES_DB=mindful_counselor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5432
POSTGRES_HOST_AUTH_METHOD=scram-sha-256

# Full database URL for backend
DATABASE_URL=postgresql://postgres:your_secure_postgres_password_here@localhost:5432/mindful_counselor

# ============================================
# Redis Configuration (Caching)
# ============================================
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_PORT=6379
REDIS_URL=redis://:your_secure_redis_password_here@localhost:6379/0

# ============================================
# OpenAI API Configuration
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# ============================================
# Application Security
# ============================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_for_jwt_signing_here
ENVIRONMENT=development

# CORS Settings (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================
# Frontend Configuration
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Mindful AI Counselor
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ============================================
# Crisis Detection System
# ============================================
CRISIS_KEYWORDS_THRESHOLD=3
CRISIS_ALERT_EMAIL=crisis-team@example.com

# Crisis keywords (internal, not exposed)
CRISIS_KEYWORDS=suicide,kill myself,end my life,self-harm,hurt myself,don't want to live

# ============================================
# Performance & Caching
# ============================================
# Maximum number of messages to keep in context
MAX_CONTEXT_MESSAGES=20

# Semantic cache TTL in seconds (1 hour)
CACHE_TTL_SECONDS=3600

# Similarity threshold for cache hits (0.0-1.0)
SIMILARITY_THRESHOLD=0.85

# Vector search top-k results
VECTOR_SEARCH_TOP_K=5

# ============================================
# Compliance & Privacy (HIPAA/GDPR)
# ============================================
# Enable encryption at rest
ENABLE_ENCRYPTION=true

# Data retention period in days
DATA_RETENTION_DAYS=90

# Enable audit logging
ENABLE_AUDIT_LOG=true

# ============================================
# Rate Limiting
# ============================================
# Chat API rate limits per user
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100

# ============================================
# Monitoring & Logging
# ============================================
LOG_LEVEL=INFO
SENTRY_DSN=

# ============================================
# Development Tools
# ============================================
# Enable debug mode (development only)
DEBUG=false

# Enable SQL query logging
SQL_ECHO=false
